# ~/.config/shunt/shunt.toml - the machines shunt can reach.
#
# Everything a host needs lives HERE, on purpose. An address kept in one file and its
# identity in another (~/.ssh/config) breaks silently the day only one of them is edited.

# The identity used for every host below, unless the host names its own.
key = "~/.ssh/id_ed25519_shunt"

[hosts]
# <alias> = "<user>@<host>"   - the usual form; `@<alias>` switches the session there
web-01 = "user@203.0.113.10"
web-02 = "user@203.0.113.20"

# A machine that needs a DIFFERENT identity - the extended form; its `key` wins over
# the default above:
# special = { target = "user@203.0.113.30", key = "~/.ssh/id_ed25519_special" }

# control_master - reuse one ssh connection for the whole session. Default: true.
#
# A very long host name can make the connection-reuse socket path too long for a unix
# socket - reuse then breaks, and the failure can read like the host being unreachable.
#
# control_master = false for such a host: commands still run, each paying its own
# handshake. Nothing of the security changes - the encryption and the authentication are
# ssh's, and the socket in /tmp simply stops existing.
#
# Usually the better fix is the IP instead of a long FQDN.

# No `key` anywhere? Then ssh chooses the identity itself, as it always did.
#
# `shunt install user@host [--alias NAME] [--key PATH]` writes an entry here for you
# (the same alias is replaced, never duplicated) and leaves the rest of the file alone.


# The audit log (~/.config/shunt/audit.log, read with `shunt log`) is an ARCHIVE, and
# trimming it is a FUSE - not a retention policy. Size is the trigger; age is only the
# unit in which room gets freed. The question people bring to this file is "where did we
# download that from, two months ago", and a short window answers it with silence.
#
# At any ordinary rate the ceiling is never reached (measured: ~15 KB per six weeks).
# That is intended: a fuse that blows regularly is a policy in disguise.
[audit]
trim_at_mb  = 100    # trim only once the log grows past this
drop_months = 2      # then the OLDEST months go - the rest of the history stays
                     # (if everything in the file is recent - something wrote a month's
                     #  worth in an hour - the oldest lines go until it fits)
