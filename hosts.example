# ~/.config/shunt/hosts — one host per line:
#
#   <alias>  <transport>  <target>            [key=PATH]
#
# transport = ssh      → secure: target is user@host (recommended)
# transport = daemon   → nonsecure: target is host:port (trusted LAN only)
#
# Lines starting with # and blank lines are ignored.

# secure (ssh) — no open port, no token:
web-01   ssh     user@203.0.113.10    key=~/.ssh/id_ed25519

# nonsecure (daemon) — token-guarded TCP, trusted LAN only:
# lan  daemon  203.0.113.50:8766

# The daemon token (nonsecure transport) is stored separately in
#   ~/.config/shunt/token   (chmod 600)
# and is written automatically by:  shunt install user@host --mode nonsecure
