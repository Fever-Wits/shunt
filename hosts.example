# ~/.config/shunt/hosts — one host per line:
#
#   <alias>  ssh  <target>            [key=PATH]
#
# target is user@host; `ssh` is the transport and the only one there is.
#
# Lines starting with # and blank lines are ignored.

web-01   ssh     user@203.0.113.10    key=~/.ssh/id_ed25519
web-02   ssh     user@203.0.113.20

# `shunt install user@host [--alias NAME] [--key PATH]` writes a line here for you
# (the same alias is replaced, never duplicated).
